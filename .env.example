# --- Backend ---
# Local dev (docker compose db on localhost:5433)
DATABASE_URL=postgresql+psycopg://slotease:slotease@localhost:5433/slotease
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MIN=60
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Optional: real emails via Resend. Leave empty to log emails to the console.
RESEND_API_KEY=
RESEND_FROM=SlotEase <onboarding@resend.dev>
RATE_LIMIT_ENABLED=true
# Optional: AI booking assistant on the public page (hidden when empty). Keep this secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Postgres container (docker-compose) ---
POSTGRES_USER=slotease
POSTGRES_PASSWORD=slotease
POSTGRES_DB=slotease

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000



