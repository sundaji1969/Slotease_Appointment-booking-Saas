# Copy to .env.prod on the server and fill in. Never commit .env.prod.
WEB_PORT=8080
POSTGRES_USER=slotease
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=slotease

JWT_SECRET=change-me-long-random
JWT_EXPIRE_MIN=60
# The public URL people open, e.g. http://YOUR_SERVER_IP:8080 (or your domain)
CORS_ORIGINS=http://localhost:8080
APP_BASE_URL=http://localhost:8080
RATE_LIMIT_ENABLED=true

RESEND_API_KEY=
RESEND_FROM=SlotEase <onboarding@resend.dev>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Behind an existing Traefik (deploy/docker-compose.traefik.yml)
SLOTEASE_HOST=slotease.example.com
